{
  "name": "fanzone-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --mode development",
    "stage": "run-s format lint check \"build-stage {@}\"",
    "prod": "run-s format lint check \"build-prod {@}\"",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-dev": "vite build --mode development",
    "build-stage": "vite build --mode staging",
    "build-prod": "vite build --mode production",
    "check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "format": "prettier --write src/",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "knip": "knip"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": [
      "oxlint --fix --deny-warnings",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@gtm-support/vue-gtm": "^3.1.0",
    "@internationalized/date": "^3.9.0",
    "@mux/mux-player": "^3.6.0",
    "@sentry/vite-plugin": "^4.3.0",
    "@sentry/vue": "^10.11.0",
    "@stripe/stripe-js": "^7.9.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tiptap/core": "^3.4.3",
    "@tiptap/extension-bold": "^3.4.4",
    "@tiptap/extension-code": "^3.4.4",
    "@tiptap/extension-document": "^3.4.4",
    "@tiptap/extension-highlight": "^3.4.3",
    "@tiptap/extension-italic": "^3.4.4",
    "@tiptap/extension-link": "^3.4.3",
    "@tiptap/extension-paragraph": "^3.4.4",
    "@tiptap/extension-strike": "^3.4.4",
    "@tiptap/extension-subscript": "^3.19.0",
    "@tiptap/extension-superscript": "^3.19.0",
    "@tiptap/extension-text": "^3.4.4",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.4.4",
    "@unhead/vue": "^2.0.17",
    "@vee-validate/zod": "^4.15.1",
    "@vite-pwa/assets-generator": "^1.0.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "base-vue-phone-input": "^0.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "js-base64": "^3.7.8",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "player.style": "^0.2.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "reka-ui": "^2.5.0",
    "swiper": "^12.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "universal-cookie": "^8.0.1",
    "vee-validate": "^4.15.1",
    "vite-plugin-pwa": "^1.0.3",
    "vue": "^3.5.21",
    "vue-easy-lightbox": "^1.19.0",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "vue3-lazyload": "^0.3.8",
    "vue3-marquee": "^4.2.2",
    "vue3-social-sharing": "^1.4.1",
    "workbox-window": "^7.3.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.31.0",
    "eslint-plugin-oxlint": "~1.8.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.5.1",
    "jsdom": "^27.0.0",
    "knip": "^5.64.0",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.16.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7",
    "workbox-build": "^7.3.0"
  },
  "packageManager": "pnpm@10.17.0"
}
