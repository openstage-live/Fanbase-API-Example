# ============================================
# OPENSTAGE FANBASE API CONFIGURATION
# ============================================

# Production
VITE_OPENSTAGE_API_FAN=https://api.openstage.live/fan2.1
VITE_OPENSTAGE_API_FAN_QUEUE=https://queue.openstage.live/fan2.1

# Staging/Development
# VITE_OPENSTAGE_API_FAN=https://api-stage.openstage.live/fan2.1
# VITE_OPENSTAGE_API_FAN_QUEUE=https://api-stage.openstage.live/fan2.1

# ============================================
# ARTIST CONFIGURATION
# ============================================

VITE_ARTIST_ID=your-artist-id
VITE_ARTIST_SHORT_NAME=artist-short-name
VITE_ARTIST_NAME=Artist Full Name
VITE_ARTIST_MIN_AGE=13

# Optional — Artist social URLs
# VITE_ARTIST_APPLE_URL=
# VITE_ARTIST_DEEZER_URL=
# VITE_ARTIST_FACEBOOK_URL=
# VITE_ARTIST_INSTAGRAM_URL=
# VITE_ARTIST_MIXCLOUD_URL=
# VITE_ARTIST_SPOTIFY_URL=
# VITE_ARTIST_TIKTOK_URL=
# VITE_ARTIST_TWITCH_URL=
# VITE_ARTIST_TWITTER_URL=
# VITE_ARTIST_WEBSITE_URL=
# VITE_ARTIST_YOUTUBE_URL=

# ============================================
# SITE METADATA
# ============================================

VITE_SITE_TITLE=Example Title
VITE_SITE_DESCRIPTION=Example Description

# ============================================
# APPLICATION URLS
# ============================================

# Production
VITE_HOME_URL=https://yourdomain.com

# Staging
# VITE_HOME_URL=https://staging.yourdomain.com

# Development
# VITE_HOME_URL=http://localhost:5173

# ============================================
# STRIPE CONFIGURATION
# ============================================

VITE_STRIPE_CONNECT_ID=acct_your_connect_id

# Production
VITE_STRIPE_PK=pk_live_your_stripe_public_key

# Staging/Development
# VITE_STRIPE_PK=pk_test_your_stripe_public_key

# ============================================
# GEOLOCATION CONFIGURATION
# ============================================

VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Production
VITE_RADAR_KEY=your-radar-api-key

# Staging/Development
# VITE_RADAR_KEY=your-radar-api-key


# ============================================
# RECAPTCHA CONFIGURATION
# ============================================

# reCAPTCHA Enterprise site key used by signup (/fan/signup-start).
# Required; ask Openstage for the key and to allow your domain.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ============================================
# MUX CONFIGURATION
# ============================================
# Production
VITE_MUX_ENV_KEY=your-mux-env-key

# Staging/Development
# VITE_MUX_ENV_KEY=your-mux-env-key

# ============================================
# BANDSINTOWN CONFIGURATION
# ============================================

# VITE_BANDSINTOWN_ARTIST_ID=
# VITE_BANDSINTOWN_API_KEY=

# ============================================
# ENVIRONMENT
# ============================================

# Production
VITE_ENV=production

# Staging
# VITE_ENV=staging

# Development
# VITE_ENV=development

# ============================================
# OPTIONAL VARIABLES (FEATURE FLAGS & INTEGRATIONS)
# ============================================

# Feature Flags
VITE_FF_TELEMETRY=false
VITE_FF_SENTRY=false
VITE_FF_GTM=false
VITE_FF_PASSWORD=your-password # Password protect the site

# Sentry (if VITE_FF_SENTRY=true)
VITE_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Google Tag Manager (if VITE_FF_GTM=true)
VITE_GTM_ID=GTM-XXXXXXX
