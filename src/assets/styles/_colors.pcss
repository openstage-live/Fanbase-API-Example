@layer base {
  :root {
    --background: 100, 100%, 100%;
    --foreground: 0, 0%, 0%;
    --card: 0, 0%, 100%;
    --card-foreground: 0, 0%, 3.9%;
    --popover: var(--background);
    --popover-foreground: var(--foreground);
    --primary: 0, 0%, 0%;
    --primary-foreground: 100, 100%, 100%;
    --secondary: 0, 0%, 0%;
    --secondary-foreground: 100, 100%, 100%;
    --muted: 0, 0%, 96.1%;
    --muted-foreground: 0, 0%, 45.1%;
    --accent: 0, 0%, 96.1%;
    --accent-foreground: 0, 0%, 9%;
    --destructive: 1, 81.6%, 62.7%;
    --destructive-foreground: 0, 100%, 20%;
    --success: 93, 73.3%, 62.7%;
    --border: 0, 0%, 0%;
    --input: 0, 0%, 0%;
    --black: 0, 0%, 0%;
    --white: 0, 0%, 100%;
    --green: 122, 100%, 66%;
    --light-grey: 0, 0%, 67%;
    --blue: 193, 96%, 67%;
    --orange: 16, 100%, 60%;
    --off-black: 0, 0%, 40%;
    --tab-inactive: 30, 33%, 95%;
  }
}
